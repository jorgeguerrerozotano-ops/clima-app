# Copia este archivo a .env.local y rellena los valores.
# .env.local no se sube a git (está en .gitignore).

# --- Servidor (Vercel): solo para el proxy de direcciones /api/ors-directions ---
# Configurar en Vercel: Project → Settings → Environment Variables
# Para desarrollo local con API: usar `vercel dev` (app + api) o definir VITE_ORS_PROXY_URL a tu URL desplegada.
# Obtener una en: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# --- Cliente (opcional): solo para geocodificación ORS en búsqueda de ubicación ---
# Si no la defines, la búsqueda usará Nominatim. Las rutas usan siempre el proxy (ORS_API_KEY en servidor).
VITE_ORS_API_KEY=
